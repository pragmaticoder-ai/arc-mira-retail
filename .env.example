# Local applications using Google infrastructure (ADC, no service-account key).
USE_MOCK=false
ENVIRONMENT=development
GOOGLE_CLOUD_PROJECT=aria-mira-retail
GOOGLE_CLOUD_REGION=asia-southeast1

# Cloud SQL: secure Python connector over public IP, no authorized networks.
CLOUD_SQL_INSTANCE=aria-mira-retail:asia-southeast1:arc-postgres-instance
ALLOYDB_DATABASE=arc
ALLOYDB_USER=arc_admin
DB_PASSWORD_SECRET=arc-db-password
# Alternative: direct PostgreSQL/AlloyDB via an existing secure network/proxy.
# Leave CLOUD_SQL_INSTANCE empty and set ALLOYDB_HOST/PORT and password/secret.
# ALLOYDB_HOST=127.0.0.1
# ALLOYDB_PORT=5432
# ALLOYDB_PASSWORD=local-only-password

BIGQUERY_DATASET=arc_dataset
BIGQUERY_LOCATION=asia-southeast1
VERTEX_AI_LOCATION=asia-southeast1
GEMINI_PRO_MODEL=gemini-2.5-flash
GEMINI_FLASH_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
ARIA_AGENT_URL=http://127.0.0.1:8001
ARIA_REQUEST_TIMEOUT_MS=120000
