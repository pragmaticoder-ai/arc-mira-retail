# ── ARC mock server configuration ───────────────────────────────────
# The mock server itself needs no secrets. These are for the BACKEND process
# that talks to it — set MOCK_SERVER_URL so the adapters route through it.

MOCK_SERVER_URL=http://localhost:8900

# Port the mock server listens on (passed to uvicorn, not read by the app):
#   uvicorn mocks.mock_server:app --port 8900
