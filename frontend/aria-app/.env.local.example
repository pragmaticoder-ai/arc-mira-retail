# ── ARIA app configuration ─────────────────────────────────────────
# All runtime config is read from env (see lib/config.ts). Nothing is
# hardcoded, so the same build runs locally and in Cloud Run. In Cloud Run
# these keys are injected from Secret Manager (--set-secrets) or as plain
# env vars (--set-env-vars). Copy this file to .env.local for local dev.

# Base URL of the deployed ARIA ADK agent.
# Leave UNSET to use the built-in scripted mock at /api/aria/chat (offline demo).
# ARIA_AGENT_URL=https://arc-aria-agent-xxxx-as.a.run.app

# Bearer token / IAM identity token for authenticated agent calls.
# In production, source this from Secret Manager — do not commit a real value.
# ARIA_AGENT_TOKEN=

# Demo session defaults (used when the client omits these fields).
DEFAULT_STORE_ID=dubai_marina_01
DEFAULT_CUSTOMER_ID=sarah_123

# Upstream timeout (ms) when proxying to the real agent.
ARIA_REQUEST_TIMEOUT_MS=15000
