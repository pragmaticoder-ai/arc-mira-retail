# ── ARC backend tools configuration ─────────────────────────────────
# All config is read from env (tools/shared/settings.py). Nothing hardcoded,
# so the same code runs locally (mock) and in Cloud Run (real GCP, values from
# Secret Manager). Copy to .env for local dev.

# ── Mode ─────────────────────────────────────────────────────────────
# true  -> every adapter uses mocks (no GCP needed). DEFAULT.
# false -> adapters call real AlloyDB / BigQuery / Vertex AI.
USE_MOCK=true

# Optional: route mock LLM/embeddings/bridge through the HTTP mock server
# (simulates real API calls over the wire). Unset -> mocks run in-process.
# MOCK_SERVER_URL=http://localhost:8900

# ── Google Cloud (used only when USE_MOCK=false) ─────────────────────
GOOGLE_CLOUD_PROJECT=mira-arc-hackathon
GOOGLE_CLOUD_REGION=asia-southeast1

# ── AlloyDB (password from Secret Manager in production) ─────────────
ALLOYDB_HOST=127.0.0.1
ALLOYDB_PORT=5432
ALLOYDB_DATABASE=postgres
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=

# ── BigQuery ─────────────────────────────────────────────────────────
BIGQUERY_DATASET=arc_dataset
BIGQUERY_LOCATION=asia-southeast1

# ── Vertex AI / Gemini ───────────────────────────────────────────────
VERTEX_AI_LOCATION=asia-southeast1
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini-1.5-flash-001
EMBEDDING_MODEL=textembedding-gecko@003
EMBEDDING_DIM=768

# ── Environment ──────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
