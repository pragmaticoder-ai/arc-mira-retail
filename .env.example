# Google Cloud
GOOGLE_CLOUD_PROJECT=mira-arc-hackathon
GOOGLE_CLOUD_REGION=asia-southeast1

# AlloyDB
ALLOYDB_HOST=<your-alloydb-private-ip>
ALLOYDB_PORT=5432
ALLOYDB_DATABASE=postgres
ALLOYDB_USER=postgres
# ALLOYDB_PASSWORD → use Secret Manager in production, .env for local only
ALLOYDB_PASSWORD=<your-password>

# BigQuery
BIGQUERY_DATASET=arc_dataset
BIGQUERY_LOCATION=asia-southeast1

# Vertex AI
VERTEX_AI_LOCATION=asia-southeast1
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini-1.5-flash-001

# Cloud Run tool service URLs (fill after deploy)
ARIA_TOOLS_URL=https://arc-aria-tools-xxxx-as.a.run.app
PULSE_TOOLS_URL=https://arc-pulse-tools-xxxx-as.a.run.app

# Frontend
FRONTEND_TYPE=aria   # or pulse

# Functional local prototype (no Google SDK execution)
USE_MOCK=true
ENVIRONMENT=development
# Use two different absolute paths; the launcher sets these automatically.
ARC_BRIDGE_DB=/tmp/arc-local/incidents.sqlite
ARC_STATE_DB=/tmp/arc-local/operations.sqlite
ARIA_AGENT_URL=http://127.0.0.1:8001
# Optional business-date override; unset uses today's date in Asia/Dubai.
# DEMO_DATE=2026-10-18
